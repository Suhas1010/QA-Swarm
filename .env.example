# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_NAV_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro
GEMINI_REPORT_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001

# GitHub Integration (optional - falls back to local Markdown export if unset)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# Orchestrator & Browser Settings
QA_SWARM_HEADLESS=true
QA_SWARM_MAX_STEPS=20
QA_SWARM_MAX_WALL_SECONDS=240
QA_SWARM_DATA_DIR=./data

